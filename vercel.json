{
  "version": 2,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.porfilr.com"
        }
      ],
      "destination": "https://porfilr.com/:path*",
      "permanent": true
    },
    {
      "source": "/trader-kit",
      "destination": "/trading-journal",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/p/index?slug=:slug"
    },
    {
      "source": "/r/:code",
      "destination": "/api/r?code=:code"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<domain>(?!(www\\.)?porfilr\\.com|.*\\.vercel\\.app|localhost).+)"
        }
      ],
      "destination": "/api/p/index?domain=:domain"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/notify/domain",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
